generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum ApplicationStatus {
  APPLIED
  ASSESSMENT
  WRITTEN_TEST
  FIRST_INTERVIEW
  SECOND_INTERVIEW
  THIRD_INTERVIEW
  HR_INTERVIEW
  OFFER
  REJECTED
  CLOSED
}

enum EventType {
  STATUS_CHANGE
  NOTE
}

model User {
  id           String           @id @default(cuid())
  username     String
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
  companies    Company[]
  categories   CompanyCategory[]
}

model CompanyCategory {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String    @default("blue")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies Company[]

  @@unique([userId, name])
  @@index([userId])
}

model Company {
  id             String           @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  categoryId     String?
  isFavorite     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       CompanyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  applications   JobApplication[]

  @@unique([userId, normalizedName])
  @@index([userId, categoryId])
  @@index([userId, isFavorite])
}

model JobApplication {
  id             String             @id @default(cuid())
  userId         String
  companyId      String
  companyName    String
  applicationUrl String @db.VarChar(2048)
  appliedAt      DateTime
  currentStatus  ApplicationStatus  @default(APPLIED)
  // Materialized product-specific sort keys keep dashboard pagination in MySQL.
  statusPriority       Int    @default(8)
  primaryPositionTitle String @default("")
  lastActivityAt DateTime
  note           String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  positions      ApplicationPosition[]
  events         ApplicationEvent[]

  @@index([userId, currentStatus])
  @@index([userId, statusPriority, appliedAt])
  @@index([userId, primaryPositionTitle])
  @@index([userId, appliedAt])
  @@index([userId, lastActivityAt])
  @@index([companyId])
}

model ApplicationPosition {
  id            String         @id @default(cuid())
  applicationId String
  priority      Int
  title         String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, priority])
  @@index([applicationId])
}

model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  type          EventType
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus?
  description   String?           @db.Text
  occurredAt    DateTime          @default(now())
  application   JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
}
